#include <windows.h>
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#undef APSTUDIO_READONLY_SYMBOLS

IDI_APP_ICON            ICON                    "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PandaSoft" "\0"
            VALUE "FileDescription", "EasyPlayer Media Player" "\0"
            VALUE "FileVersion", "1.0.0.1" "\0"
            VALUE "InternalName", "EasyPlayer" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 PandaSoft. All rights reserved." "\0"
            VALUE "OriginalFilename", "EasyPlayer.exe" "\0"
            VALUE "ProductName", "EasyPlayer" "\0"
            VALUE "ProductVersion", "1.0.0.1" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
